# DIG Crates prototype. No secrets are required: all data is local fixture JSON.

# Optional. Public origin of the deployed DIG app, used by the launcher docs and
# to build absolute embed URLs. Leave empty for local development.
NEXT_PUBLIC_DIG_APP_ORIGIN=

# Optional. Set to 1 to allow http://localhost:* and http://127.0.0.1:* host pages
# to frame /embed/* and exchange postMessage events in a production build.
DIG_ALLOW_LOCALHOST_EMBED=1
