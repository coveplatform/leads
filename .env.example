PORT=3000

# ─── Required ───
BASE_URL=http://localhost:3000
# For production: BASE_URL=https://usecove.app
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-this-to-a-long-random-string
# Logins allowed into /admin (comma-separated). Defaults to Kris.
ADMIN_EMAILS=

# ─── Twilio ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Number provisioning (used by the onboarding script)
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
TWILIO_MESSAGING_SERVICE_SID=
# Public URL Twilio calls when BASE_URL is localhost
PRODUCTION_URL=https://usecove.app

# ─── Scheduled jobs ───
# Vercel cron sends `Authorization: Bearer <CRON_SECRET>`. Set it in Vercel; if
# unset, the cron endpoints only accept Vercel's own scheduler.
CRON_SECRET=

# ─── Optional: owner email alerts (Resend) ───
RESEND_API_KEY=
NOTIFY_EMAIL=Cove <hello@usecove.app>

# ─── Alerts to Kris (enquiries, forwarding gone quiet, failed health check) ───
ADMIN_ALERT_EMAIL=hello@usecove.app
ADMIN_ALERT_PHONE=
# Any Cove Twilio number to send alert texts from
ADMIN_ALERT_FROM=

# ─── Testing ───
# When set to 1, sendSms logs instead of calling Twilio (used by the E2E
# script). Never set this in production.
SMS_DRY_RUN=
# Local Postgres for `npm run e2e:local`, e.g. postgresql://localhost/cove_e2e
E2E_PG_URL=

DEBUG=false
