# ─── Database ───
# Leave DATABASE_URL empty to run in zero-config demo mode: DIG then runs an
# embedded Postgres (PGlite) stored in ./.data/pglite and seeds the demo
# catalogue on first start. Set DATABASE_URL (Supabase or any Postgres) for a
# shared/deployed database; run `npm run db:migrate && npm run db:seed` once.
DATABASE_URL=
# memory | file | postgres  (defaults: postgres when DATABASE_URL is set, else file)
DIG_DB=
PGLITE_DATA_DIR=./.data/pglite
# Seed the demo catalogue automatically if the catalogue is empty (default 1)
DIG_AUTO_SEED=1

# ─── Sessions ───
# Signs guest cookies. Any long random string. Required in production.
DIG_SESSION_SECRET=change-me-to-a-long-random-string
# Guest cookies expire after this many days (default 180)
DIG_GUEST_TTL_DAYS=180

# ─── Providers (all optional; everything falls back honestly without them) ───
# Allow server-side calls to official provider metadata endpoints
# (YouTube and SoundCloud oEmbed). 0 = parse URLs only, no network.
DIG_PROVIDER_NETWORK=1
# Not required for embeds. Only needed for Data API search (not used in Phase 1).
YOUTUBE_API_KEY=
# MusicBrainz enrichment is off by default; requires reviewing its licence first.
MUSICBRAINZ_ENRICHMENT=0
MUSICBRAINZ_USER_AGENT=DIG/0.1 (contact@example.com)

# ─── Optional Supabase Auth (account sign-in). Guest mode works without it. ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Debug ───
# 1 exposes ranking score traces on /api/v1/digs/:id/next?debug=1
DIG_DEBUG_RANKING=0
